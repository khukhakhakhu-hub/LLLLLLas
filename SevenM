--==========================================================
-- HELPERS
--==========================================================
local function enemy(p)
    if not Config.Team then return true end
    if not p.Team or not L.Team then return true end
    return p.Team ~= L.Team
end

local function getAimPart(ch)
    if not ch then return nil end
    if Config.AimPart == "Head" then return ch:FindFirstChild("Head") end
    if Config.AimPart == "UpperTorso" then return ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso") end
    if Config.AimPart == "LowerTorso" then return ch:FindFirstChild("LowerTorso") or ch:FindFirstChild("Torso") end
    return ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Torso")
end

--==========================================================
-- AIMBOT
--==========================================================
local function los(part)
    if not Config.Wall then return true end
    local q = RaycastParams.new()
    q.FilterType = Enum.RaycastFilterType.Exclude
    q.FilterDescendantsInstances = { L.Character }
    local r = workspace:Raycast(C.CFrame.Position, part.Position - C.CFrame.Position, q)
    return not r or r.Instance:IsDescendantOf(part.Parent)
end

local function target()
    local best, bd = nil, math.huge
    local center = C.ViewportSize / 2
    for _, p in ipairs(P:GetPlayers()) do
        if enemy(p) and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local x = getAimPart(p.Character)
            if h and h.Health > 0 and x then
                local d = (C.CFrame.Position - x.Position).Magnitude
                local s, v = C:WorldToViewportPoint(x.Position)
                local sd = (Vector2.new(s.X, s.Y) - center).Magnitude
                if d <= Config.Dist and v and sd <= Config.AimFOV and sd < bd and los(x) then
                    bd = sd
                    best = x
                end
            end
        end
    end
    return best
end

--==========================================================
-- ESP
--==========================================================
local espCache = {}

local function getObj(p)
    if not espCache[p] then
        espCache[p] = {
            Box    = Drawing.new("Square"),
            Name   = Drawing.new("Text"),
            Dist   = Drawing.new("Text"),
            HPBg   = Drawing.new("Square"),
            HPFg   = Drawing.new("Square"),
            Tracer = Drawing.new("Line"),
            Head   = Drawing.new("Circle"),
        }
        local e = espCache[p]
        e.Box.Thickness = 1 e.Box.Filled = false
        e.Name.Size = 14 e.Name.Center = true e.Name.Outline = true
        e.Dist.Size = 12 e.Dist.Center = true e.Dist.Outline = true
        e.HPBg.Filled = true e.HPFg.Filled = true
        e.Tracer.Thickness = 1
        e.Head.Thickness = 1 e.Head.Filled = true e.Head.NumSides = 16 e.Head.Radius = 3
    end
    return espCache[p]
end

local function hideESP(p)
    local e = espCache[p]
    if e then for _, o in pairs(e) do o.Visible = false end end
end

P.PlayerRemoving:Connect(function(p)
    if espCache[p] then
        for _, o in pairs(espCache[p]) do pcall(function() o:Remove() end) end
        espCache[p] = nil
    end
end)

local function drawESP(p)
    if p == L then hideESP(p) return end
    local ch = p.Character
    if not ch then hideESP(p) return end
    if not enemy(p) then hideESP(p) return end

    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then hideESP(p) return end

    local root = ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Torso") or ch:FindFirstChild("LowerTorso")
    local head = ch:FindFirstChild("Head")
    if not root or not head then hideESP(p) return end

    local camPos = C.CFrame.Position
    local dd = (root.Position - camPos).Magnitude
    if dd > Config.ESPDist then hideESP(p) return end

    local headPos = head.Position + Vector3.new(0, 0.6, 0)
    local footPos = root.Position - Vector3.new(0, 3, 0)

    local hS, onH = C:WorldToViewportPoint(headPos)
    local fS, onF = C:WorldToViewportPoint(footPos)
    if not onH and not onF then hideESP(p) return end

    local e = getObj(p)
    local h = math.abs(hS.Y - fS.Y)
    local w = h * 0.5
    local pos = Vector2.new(hS.X - w / 2, hS.Y)

    e.Box.Visible = Config.Box
    e.Box.Size = Vector2.new(w, h)
    e.Box.Position = pos
    e.Box.Color = Config.ColorBox

    e.Name.Visible = Config.Name
    e.Name.Text = p.Name
    e.Name.Position = Vector2.new(hS.X, hS.Y - 18)
    e.Name.Color = Config.ColorName

    e.Dist.Visible = Config.Distance
    e.Dist.Text = string.format("[%d]", math.floor(dd))
    e.Dist.Position = Vector2.new(hS.X, hS.Y + h + 2)
    e.Dist.Color = Config.ColorDistance

    local hpPct = math.clamp(hum.Health / 100, 0, 1)
    e.HPBg.Visible = Config.Health
    e.HPBg.Size = Vector2.new(2, h)
    e.HPBg.Position = pos - Vector2.new(6, 0)
    e.HPBg.Color = Color3.fromRGB(0, 0, 0)

    e.HPFg.Visible = Config.Health
    e.HPFg.Size = Vector2.new(2, h * hpPct)
    e.HPFg.Position = Vector2.new(pos.X - 6, pos.Y + (h * (1 - hpPct)))
    e.HPFg.Color = Config.ColorHealth

    e.Tracer.Visible = Config.Tracer
    e.Tracer.From = Vector2.new(C.ViewportSize.X / 2, C.ViewportSize.Y)
    e.Tracer.To = Vector2.new(hS.X, hS.Y)
    e.Tracer.Color = Config.ColorTracer

    e.Head.Visible = Config.HeadDot
    e.Head.Position = Vector2.new(hS.X, hS.Y)
    e.Head.Color = Config.ColorHeadDot
end

--==========================================================
-- MAIN LOOP
--==========================================================
R.RenderStepped:Connect(function()
    if Config.POVCircle then
        F.Visible = true
        F.Size = UDim2.fromOffset(Config.AimFOV * 2, Config.AimFOV * 2)
        stroke.Color = Config.ColorFOV
    else
        F.Visible = false
    end

    if C and C.FieldOfView ~= Config.CamFOV then
        C.FieldOfView = Config.CamFOV
    end

    if Config.Aim then
        local x = target()
        if x then
            if Config.SilentAim then
                local myRoot = L.Character and (L.Character:FindFirstChild("HumanoidRootPart") or L.Character:FindFirstChild("Torso"))
                if myRoot then
                    local dir = x.Position - myRoot.Position
                    local flat = Vector3.new(dir.X, 0, dir.Z)
                    if flat.Magnitude > 0 then
                        myRoot.CFrame = CFrame.new(myRoot.Position, myRoot.Position + flat.Unit)
                    end
                end
            else
                C.CFrame = C.CFrame:Lerp(CFrame.lookAt(C.CFrame.Position, x.Position), Config.Smooth)
            end
        end
    end

    if Config.CamFollow then
        local x = target()
        if x then
            C.CFrame = C.CFrame:Lerp(CFrame.lookAt(C.CFrame.Position, x.Position), Config.CamFollowSpeed)
        end
    end

    if Config.ESP then
        for _, p in ipairs(P:GetPlayers()) do drawESP(p) end
    else
        for p, _ in pairs(espCache) do hideESP(p) end
    end
end)

