    title.Size = UDim2.new(1, -40, 0, 28)
    title.Position = UDim2.fromOffset(10, 4)
    title.BackgroundTransparency = 1
    title.Text = "Pick Color"
    title.TextColor3 = Color3.new(1, 1, 1)
