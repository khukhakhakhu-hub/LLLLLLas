    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Font = Enum.Font.GothamBold

    local close = Instance.new("TextButton", frame)
    close.Size = UDim2.fromOffset(24, 24)
    close.Position = UDim2.new(1, -32, 0, 6)
    close.Text = "×"
    close.TextColor3 = Color3.new(1, 1, 1)
    close.TextSize = 16
    close.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    close.BorderSizePixel = 0
    Instance.new("UICorner", close).CornerRadius = UDim.new(1, 0)

    -- ★ Box container
    local boxFrame = Instance.new("Frame", frame)
    boxFrame.Size = UDim2.fromOffset(220, 200)
    boxFrame.Position = UDim2.fromOffset(20, 40)
    boxFrame.BackgroundColor3 = Color3.new(1, 1, 1)     -- ★ ขาว base
    boxFrame.BorderSizePixel = 0
    boxFrame.ClipsDescendants = true
    Instance.new("UICorner", boxFrame).CornerRadius = UDim.new(0, 6)

    -- ★ Hue gradient — base ขาว → gradient แสดงสีรุ้งจริง
    local hueGradient = Instance.new("Frame", boxFrame)
    hueGradient.Size = UDim2.fromScale(1, 1)
    hueGradient.BackgroundColor3 = Color3.new(1, 1, 1)   -- ★ ขาว
    hueGradient.BorderSizePixel = 0
    hueGradient.BackgroundTransparency = 0
    Instance.new("UICorner", hueGradient).CornerRadius = UDim.new(0, 6)

    local hueGrad = Instance.new("UIGradient", hueGradient)
    hueGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
        ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
        ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
        ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 0, 255)),
        ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
    })

    -- ★ Saturation overlay — ดำไล่ลงล่าง
    local satOverlay = Instance.new("Frame", boxFrame)
    satOverlay.Size = UDim2.fromScale(1, 1)
    satOverlay.BackgroundColor3 = Color3.new(0, 0, 0)     -- ★ ดำ base
    satOverlay.BorderSizePixel = 0
    satOverlay.BackgroundTransparency = 0
    Instance.new("UICorner", satOverlay).CornerRadius = UDim.new(0, 6)

    local satGrad = Instance.new("UIGradient", satOverlay)
    satGrad.Rotation = 90                                  -- ตั้ง
    satGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),   -- บน: ทึบ (ดำ)
        NumberSequenceKeypoint.new(1, 1),   -- ล่าง: โปร่งใส
    })

    -- ★ Cursor dot
    local cursorDot = Instance.new("Frame", boxFrame)
