    cursorDot.Position = UDim2.fromScale(0, 0)
    cursorDot.BackgroundColor3 = Color3.new(1, 1, 1)
    cursorDot.BorderSizePixel = 2
    cursorDot.BorderColor3 = Color3.new(0, 0, 0)
    cursorDot.ZIndex = 5
    Instance.new("UICorner", cursorDot).CornerRadius = UDim.new(1, 0)

    -- Value slider
    local valBg = Instance.new("Frame", frame)
    valBg.Size = UDim2.fromOffset(220, 20)
    valBg.Position = UDim2.fromOffset(20, 250)
    valBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    valBg.BorderSizePixel = 0
    Instance.new("UICorner", valBg).CornerRadius = UDim.new(0, 4)

    local valFill = Instance.new("Frame", valBg)
    valFill.Size = UDim2.fromScale(1, 1)
    valFill.BackgroundColor3 = Color3.new(1, 1, 1)
    valFill.BorderSizePixel = 0
    Instance.new("UICorner", valFill).CornerRadius = UDim.new(0, 4)

    local valLabel = Instance.new("TextLabel", frame)
    valLabel.Size = UDim2.new(1, -40, 0, 20)
    valLabel.Position = UDim2.fromOffset(20, 275)
    valLabel.BackgroundTransparency = 1
    valLabel.Text = "Value"
    valLabel.TextColor3 = Color3.new(1, 1, 1)
    valLabel.TextSize = 12
    valLabel.TextXAlignment = Enum.TextXAlignment.Left

    -- Preview swatch
    local preview = Instance.new("Frame", frame)
    preview.Size = UDim2.fromOffset(80, 30)
    preview.Position = UDim2.fromOffset(160, 275)
    preview.BackgroundColor3 = Color3.new(1, 1, 1)
    preview.BorderSizePixel = 2
    preview.BorderColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", preview).CornerRadius = UDim.new(0, 4)

    local hue, sat, val = 0, 1, 1
    local callback = nil
    local draggingBox, draggingVal = false, false

    local function updateColor()
        local c = Color3.fromHSV(hue, sat, val)
        preview.BackgroundColor3 = c
        valFill.BackgroundColor3 = Color3.fromHSV(hue, sat, 1)
        if callback then callback(c) end
    end

    local function updateFromBox(x, y)
        local relX = math.clamp((x - boxFrame.AbsolutePosition.X) / boxFrame.AbsoluteSize.X, 0, 1)
        local relY = math.clamp((y - boxFrame.AbsolutePosition.Y) / boxFrame.AbsoluteSize.Y, 0, 1)
        hue = relX
        sat = 1 - relY
        cursorDot.Position = UDim2.fromScale(relX, relY)
        updateColor()
    end

    local function updateFromVal(x)
        local rel = math.clamp((x - valBg.AbsolutePosition.X) / valBg.AbsoluteSize.X, 0, 1)
        val = rel
        valFill.Size = UDim2.new(rel, 0, 1, 0)
        updateColor()
    end

    boxFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingBox = true
            updateFromBox(input.Position.X, input.Position.Y)
        end
    end)
    valBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingVal = true
            updateFromVal(input.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            if draggingBox then updateFromBox(input.Position.X, input.Position.Y) end
            if draggingVal then updateFromVal(input.Position.X) end
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingBox = false
            draggingVal = false
        end
    end)

    close.Activated:Connect(function() frame.Visible = false end)

    ColorPicker = {
        Open = function(title_, initColor, cb)
            title.Text = title_
            callback = cb
            local h, s, v = initColor:ToHSV()
            hue, sat, val = h, s, v
            cursorDot.Position = UDim2.fromScale(h, 1 - s)
            valFill.Size = UDim2.new(v, 0, 1, 0)
            preview.BackgroundColor3 = initColor
            frame.Visible = true
        end,
    }
end

